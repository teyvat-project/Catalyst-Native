{
  "name": "@natsuneko-laboratory/catalyst-mobile",
  "version": "1.2.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuilt": "run-s -c bin:*",
    "bin:emoji-gen": "tsx ./bin/emoji-gen.ts",
    "emoji:fetch": "tsx ./bin/emoji-gen.ts --fetch",
    "bin:license-list": "tsx ./bin/license-list.ts",
    "clean:nix": "rm -rf node_modules && rm -fr $TMPDIR/haste-map-* && rm -fr $TMPDIR/metro-cache",
    "clean:win": "rmdir /s /q node_modules && del %LOCALAPPDATA%/Temp/haste-map-* && del %LOCALAPPDATA%/Temp/metro-cache",
    "run:android": "pnpm run prebuilt && pnpm with-env expo run:android",
    "run:ios": "pnpm run prebuilt && pnpm with-env expo run:ios",
    "run:ios:op": "pnpm run prebuilt && pnpm with-op expo run:ios",
    "run:ios:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:ios",
    "run:android:op": "pnpm run prebuilt && pnpm with-op expo run:android",
    "run:android:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:android",
    "build:production": "pnpm with-op run-s -c build:*:production",
    "build:android:development": "pnpm run prebuilt && eas build --platform android --profile development --local",
    "build:android:preview": "pnpm run prebuilt && eas build --platform android --profile preview --local",
    "build:android:production": "pnpm run prebuilt && eas build --platform android --profile production --local",
    "build:ios:development": "pnpm run prebuilt && eas build --platform ios --profile development --local",
    "build:ios:preview": "pnpm run prebuilt && eas build --platform ios --profile preview --local",
    "build:ios:production": "pnpm run prebuilt && eas build --platform ios --profile production --local",
    "submit:android:preview": "eas submit --platform android --profile preview",
    "submit:android:production": "eas submit --platform android --profile production",
    "submit:ios:preview": "eas submit --platform ios --profile preview",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "lint": "pnpm -w run lint:mobile",
    "expo": "expo",
    "with-env": "dotenv -e .env.local --",
    "with-op": "cross-env FORCE_COLOR=true op run --env-file=./.env --",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "dependencies": {
    "@expo/config": "~58.0.6",
    "@expo/dom-webview": "^58.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@luccasr73/with-rn-image-crop-picker": "^0.1.5",
    "@natsuneko-laboratory/catalyst-sdk": "catalog:",
    "@natsuneko-laboratory/fleet-renderer-core": "catalog:",
    "@natsuneko-laboratory/fleet-renderer-react-native": "catalog:",
    "@natsuneko-laboratory/memora": "catalog:",
    "@natsuneko-laboratory/react-native-carousel-viewer": "workspace:*",
    "@natsuneko-laboratory/react-native-emoji-verse": "catalog:",
    "@natsuneko-laboratory/react-native-twitter-text": "catalog:",
    "@natsuneko-laboratory/react-native-webcrypto-digest": "catalog:",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/messaging": "^26.3.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/drawer": "^7.13.6",
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@sentry/react-native": "^8.28.0",
    "@shopify/flash-list": "^2.3.1",
    "clsx": "catalog:",
    "cn": "catalog:",
    "dayjs": "^1.11.23",
    "expo": "~58.0.16",
    "expo-asset": "^58.0.17",
    "expo-build-properties": "^58.0.11",
    "expo-clipboard": "^58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-eas-ipad-support": "^1.0.0",
    "expo-file-system": "^58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "^58.0.10",
    "expo-linking": "~58.0.13",
    "expo-media-library": "~58.0.11",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "jotai": "^2.20.3",
    "jotai-family": "^1.1.0",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.41.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "^5.1.3",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "twitter-text": "^3.1.0",
    "unified": "^11.0.5",
    "uniwind": "catalog:",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@callstack/licenses": "^0.3.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "^19.2.7",
    "@types/twitter-text": "^3.1.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-preset-expo": "^58.0.18",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eas-cli": "^23.0.0",
    "eas-cli-local-build-plugin": "^23.0.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "npm-run-all2": "^9.0.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}